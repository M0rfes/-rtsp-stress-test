# Configuration for RTSP Video Grid Benchmark (Rust Tauri GPU Zero-Copy Hardware Decode)
STREAM_COUNT=30
RTSP_URL=rtsp://127.0.0.1:8554/live
# Optional pattern for multi-channel RTSP servers:
# RTSP_URL_PATTERN=rtsp://127.0.0.1:8554/stream%d
WS_PORT=9999
BENCHMARK_LOG_DIR=/var/log/benchmark
FPS_METRICS_LOG_PATH=/var/log/benchmark/fps_metrics.log
HARDWARE_METRICS_LOG_PATH=/var/log/benchmark/hardware_metrics.csv
MACHINE_ID=c7i-8xlarge-node-1
