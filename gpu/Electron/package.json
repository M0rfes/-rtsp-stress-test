{
  "name": "rtsp-stress-test-electron-gpu",
  "version": "1.0.0",
  "description": "24-Hour 30-stream 1440p 25fps RTSP Video Grid Benchmark (Electron GPU Zero-Copy Hardware Decode)",
  "main": "dist/main/index.js",
  "scripts": {
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "start": "electron . --enable-features=VaapiVideoDecoder,VaapiVideoDecodeLinuxGL,VaapiOnNvidiaGPUs --use-gl=egl --disable-software-rasterizer",
    "dev:renderer": "vite",
    "dev": "npm run build:main && concurrently -k -n \"VITE,ELECTRON\" -c \"blue,green\" \"vite\" \"electron . --enable-features=VaapiVideoDecoder,VaapiVideoDecodeLinuxGL,VaapiOnNvidiaGPUs --use-gl=egl --disable-software-rasterizer\"",
    "rtsp:feed": "./scripts/start_rtsp_feed.sh",
    "poll:hardware": "./scripts/poll_hardware.sh",
    "start:headless": "xvfb-run -a -s \"-screen 0 2560x1440x24\" electron . --enable-features=VaapiVideoDecoder,VaapiVideoDecodeLinuxGL,VaapiOnNvidiaGPUs --use-gl=egl --disable-software-rasterizer",
    "benchmark:headless": "./scripts/run_benchmark_headless.sh"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  }
}
