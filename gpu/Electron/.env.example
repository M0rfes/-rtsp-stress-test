# Benchmark Environment Configuration
# Number of concurrent RTSP streams (default 30 per specification)
STREAM_COUNT=30

# RTSP Stream Source
# Option A: Connect to separate RTSP server box in same AWS VPC (e.g. 10.0.1.50):
RTSP_URL=rtsp://10.0.1.50:8554/live

# Option B: Local MediaMTX test feed (if running on single machine):
# RTSP_URL=rtsp://127.0.0.1:8554/live

# Option C: 30 unique stream paths across VPC:
# RTSP_URL_PATTERN=rtsp://10.0.1.50:8554/stream%d

# WebSocket Port for IPC
WS_PORT=9999

# Machine identifier for telemetry
MACHINE_ID=g6-xlarge-node-1

# Telemetry Log Output Paths (defaults to /var/log/benchmark/ on Linux)
BENCHMARK_LOG_DIR=/var/log/benchmark
FPS_METRICS_LOG_PATH=/var/log/benchmark/fps_metrics.log
HARDWARE_METRICS_LOG_PATH=/var/log/benchmark/hardware_metrics.csv
