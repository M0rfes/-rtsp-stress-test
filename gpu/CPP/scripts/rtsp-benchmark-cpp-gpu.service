[Unit]
Description=6-Hour RTSP 30-Stream Video Grid Benchmark (C++ Qt6 GPU Zero-Copy)
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/rtsp-stress-test/gpu/CPP
Environment=BENCHMARK_LOG_DIR=/var/log/benchmark
Environment=RTSP_URL=rtsp://127.0.0.1:8554/live
Environment=STREAM_COUNT=30
Environment=HW_ACCEL=auto
ExecStart=/opt/rtsp-stress-test/gpu/CPP/scripts/run_benchmark_headless.sh
Restart=always
RestartSec=5
KillMode=mixed
TimeoutStopSec=15
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
